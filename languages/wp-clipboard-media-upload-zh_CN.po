#: wp-clipboard-media-upload.php:48
msgid "Paste image here (Ctrl+V) to upload"
msgstr "点击此处并按下 Ctrl+V 粘贴上传图片"

#: wp-clipboard-media-upload.php:50
msgid "Uploading from clipboard..."
msgstr "正在从剪贴板上传..."

#: wp-clipboard-media-upload.php:51
msgid "Upload successful!"
msgstr "上传成功！"

#: wp-clipboard-media-upload.php:52
msgid "Upload failed: "
msgstr "上传失败："

#: wp-clipboard-media-upload.php:53
msgid "Network or server error"
msgstr "网络连接或服务器错误"

#: wp-clipboard-media-upload.php:54
msgid " - Cropping..."
msgstr " - 裁剪中..."

#: wp-clipboard-media-upload.php:55
msgid " - Scaling..."
msgstr " - 缩放中..."

#: wp-clipboard-media-upload.php:56
msgid "Crop"
msgstr "裁剪"

#: wp-clipboard-media-upload.php:57
msgid "Width"
msgstr "限宽"

#: wp-clipboard-media-upload.php:58
msgid "Height"
msgstr "限高"

#: wp-clipboard-media-upload.php:59
msgid "Set image processing rules:"
msgstr "设置图片处理规则："

#: wp-clipboard-media-upload.php:60
msgid "1. Crop: '300x300'\n2. Max Width: '300'\n3. Max Height: '0x300'\n\nEmpty to disable."
msgstr "1. 裁剪: 输入 '300x300' (居中裁剪)\n2. 限宽: 输入 '300' 或 '300x0' (高度自适应)\n3. 限高: 输入 '0x300' (宽度自适应)\n\n留空或取消则关闭功能。"

#: wp-clipboard-media-upload.php:61
msgid "Click to set size:\n- 300x300: Center Crop\n- 300: Max Width\n- 0x300: Max Height"
msgstr "点击设置尺寸：\n- 300x300 : 居中裁剪\n- 300 (或 300x0) : 限制最大宽度\n- 0x300 : 限制最大高度"

#: wp-clipboard-media-upload.php:70
msgid "Permission denied."
msgstr "权限不足，您没有上传文件的权限。"

#: wp-clipboard-media-upload.php:74
msgid "No file received."
msgstr "未接收到文件。"

#: wp-clipboard-media-upload.php:90
msgid "Only image files (JPG, PNG, GIF, WEBP) are allowed."
msgstr "只允许上传图片文件 (JPG, PNG, GIF, WEBP)。"